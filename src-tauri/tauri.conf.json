{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "envy",
  "mainBinaryName": "envy-loader",
  "version": "0.1.0",
  "identifier": "com.envy.loader",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "nl://localhost/index.html",
        "title": "envy",
        "width": 560,
        "height": 500,
        "resizable": false,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "app_icon.png"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  }
}
