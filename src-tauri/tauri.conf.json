{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "neverlose",
  "version": "0.1.0",
  "identifier": "com.neverlose.launcher",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "nl://localhost/index.html",
        "title": "neverlose",
        "width": 560,
        "height": 500,
        "resizable": false,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "app_icon.png"
    ],
    "resources": [
      "resources/injector.exe",
      "resources/neverlose.dll",
      "resources/lua_libs.zip"
    ],
    "windows": {
      "digestAlgorithm": "sha256"
    }
  }
}
